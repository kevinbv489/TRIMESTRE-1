<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_MaryNails" targetNamespace="http://marynails.example/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.33.0">
  <bpmn:collaboration id="Collab_MaryNails">
    <bpmn:participant id="Part_Cliente" name="Cliente" processRef="Proc_Cliente" />
    <bpmn:participant id="Part_Admin" name="Administradora / Recepción" processRef="Proc_Admin" />
    <bpmn:participant id="Part_Mani" name="Manicurista" processRef="Proc_Mani" />
    <bpmn:messageFlow id="m1" name="Solicitud de cita" sourceRef="C_solicitar" targetRef="A_recibir" />
    <bpmn:messageFlow id="m2" name="Otro horario" sourceRef="A_proponer" targetRef="C_solicitar" />
    <bpmn:messageFlow id="m3" name="Confirmación" sourceRef="A_confirmar" targetRef="C_confirmacion" />
    <bpmn:messageFlow id="m4" name="Cancelación" sourceRef="C_avisar" targetRef="A_cancelar" />
    <bpmn:messageFlow id="m5" name="Cliente en el salón" sourceRef="C_asistir" targetRef="M_atender" />
    <bpmn:messageFlow id="m6" name="Pago" sourceRef="C_pagar" targetRef="A_cobrar" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Cliente" isExecutable="false">
    <bpmn:startEvent id="C_ini" name="Necesita un servicio de belleza">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="C_consultar" name="Consultar servicios, precios y horarios">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_solicitar" name="Solicitar cita (servicio, fecha y hora)">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_confirmacion" name="Recibir la confirmación">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="C_asiste" name="¿Asiste a la cita?">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="C_avisar" name="Avisar que cancela la cita">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="C_asistir" name="Asistir al salón y recibir el servicio">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_pagar" name="Pagar el servicio">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="C_fin" name="Cliente atendido">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="C_ini" targetRef="C_consultar" />
    <bpmn:sequenceFlow id="f2" sourceRef="C_consultar" targetRef="C_solicitar" />
    <bpmn:sequenceFlow id="f3" sourceRef="C_solicitar" targetRef="C_confirmacion" />
    <bpmn:sequenceFlow id="f4" sourceRef="C_confirmacion" targetRef="C_asiste" />
    <bpmn:sequenceFlow id="f5" name="Sí" sourceRef="C_asiste" targetRef="C_asistir" />
    <bpmn:sequenceFlow id="f6" name="No" sourceRef="C_asiste" targetRef="C_avisar" />
    <bpmn:sequenceFlow id="f7" sourceRef="C_asistir" targetRef="C_pagar" />
    <bpmn:sequenceFlow id="f8" sourceRef="C_pagar" targetRef="C_fin" />
  </bpmn:process>
  <bpmn:process id="Proc_Admin" isExecutable="false">
    <bpmn:task id="A_recibir" name="Recibir la solicitud de cita">
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A_horario" name="¿Hay horario disponible?">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_proponer" name="Proponer otro horario al cliente">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="A_registrar" name="Registrar la cita en la agenda (Pendiente)">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_confirmar" name="Confirmar la cita al cliente">
      <bpmn:incoming>f12</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="A_cancelar" name="Cancelar la cita en la agenda">
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="A_fin_canc" name="Cita cancelada">
      <bpmn:incoming>f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="A_cobrar" name="Cobrar y registrar el servicio">
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="A_fin" name="Atención registrada">
      <bpmn:incoming>f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f9" sourceRef="A_recibir" targetRef="A_horario" />
    <bpmn:sequenceFlow id="f10" name="Sí" sourceRef="A_horario" targetRef="A_registrar" />
    <bpmn:sequenceFlow id="f11" name="No" sourceRef="A_horario" targetRef="A_proponer" />
    <bpmn:sequenceFlow id="f12" sourceRef="A_registrar" targetRef="A_confirmar" />
    <bpmn:sequenceFlow id="f13" sourceRef="A_cancelar" targetRef="A_fin_canc" />
    <bpmn:sequenceFlow id="f14" sourceRef="A_cobrar" targetRef="A_fin" />
  </bpmn:process>
  <bpmn:process id="Proc_Mani" isExecutable="false">
    <bpmn:task id="M_atender" name="Atender al cliente y realizar el servicio">
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="M_fin" name="Servicio realizado">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f15" sourceRef="M_atender" targetRef="M_fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_MaryNails">
      <bpmndi:BPMNShape id="Part_Cliente_di" bpmnElement="Part_Cliente" isHorizontal="true">
